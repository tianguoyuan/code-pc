{
  "name": "cnode-pc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CNode 社区 PC 端（Vue 3 + Vite + Element Plus）",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\" \"*.{ts,json,md}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.8.4",
    "dompurify": "^3.2.4",
    "element-plus": "^2.9.7",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "typescript": "~5.7.3",
    "unocss": "^66.0.0",
    "vite": "^6.2.3",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=18"
  }
}
